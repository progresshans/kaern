# Settings for script/release.sh. Copy this file to `.env` (it isn't committed) and change what differs.

# The Developer ID Application identity, as `security find-identity -v -p codesigning` prints it.
# Empty: the first Developer ID Application identity in your keychain.
KAERN_SIGN_IDENTITY=""

# The notarytool keychain profile. It holds your Apple ID's credentials, not an app's, so one serves all your apps.
# Make it once: xcrun notarytool store-credentials progresshans-notary --apple-id <Apple ID> --team-id <team ID>
KAERN_NOTARY_PROFILE="progresshans-notary"

# The keychain account of the EdDSA key that signs Sparkle updates (script/release.sh keys makes it).
KAERN_SPARKLE_KEY_ACCOUNT="kaern"

# Where releases are published (GitHub Releases) and the appcast is served (GitHub Pages from docs/).
# Packaging/Info.plist's SUFeedURL and KaernSourceURL name the same place.
KAERN_GITHUB_REPOSITORY="progresshans/kaern"
