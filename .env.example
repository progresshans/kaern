# Settings for script/release.sh on your Mac. Copy this file to `.env` (it isn't committed) and change what differs.
# GitHub Actions doesn't read it: the release workflow sets what it needs (Packaging/README.md).

# The Developer ID Application identity, as `security find-identity -v -p codesigning` prints it.
# Empty: the first Developer ID Application identity in your keychain.
KAERN_SIGN_IDENTITY=""

# The notarytool keychain profile. It holds your account's credentials, not an app's, so one serves all your apps.
# Make it once with an App Store Connect API key (Packaging/README.md):
#   xcrun notarytool store-credentials progresshans-notary --key <AuthKey_….p8> --key-id <key ID> --issuer <issuer ID>
KAERN_NOTARY_PROFILE="progresshans-notary"

# The keychain account of the EdDSA key that signs Sparkle updates (script/release.sh keys makes it).
KAERN_SPARKLE_KEY_ACCOUNT="kaern"

# Where releases are published (GitHub Releases) and the appcast is served (GitHub Pages from the gh-pages branch).
# Packaging/Info.plist's SUFeedURL and KaernSourceURL name the same place.
KAERN_GITHUB_REPOSITORY="progresshans/kaern"
